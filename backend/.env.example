# AgentForge backend — environment
#
# API keys, endpoints, model names and upload limits are configured in the web UI
# under Settings and stored in the database. Only bootstrap values live here, and
# all of them have working defaults.

DATABASE_URL=sqlite+aiosqlite:///./data/agentforge.db
CHROMA_PERSIST_DIRECTORY=./data/chroma_data

# Optional
#   DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/agentforge
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=
CORS_ORIGINS=
SECRET_KEY=

LOG_LEVEL=INFO
DEBUG=False
