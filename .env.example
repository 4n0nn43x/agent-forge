# AgentForge — environment
#
# Almost nothing lives here any more. API keys, endpoints, model names and
# upload limits are configured in the web UI, under Settings (/settings), and
# stored in the database. Secrets are encrypted at rest.
#
# Only bootstrap values remain: they are needed before the database can be read.
# Every one of them has a working default — an empty .env is a valid .env.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Default: a SQLite file under ./data. Point it at PostgreSQL to use a real
# database (recommended if you already run one):
#   DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/agentforge
DATABASE_URL=sqlite+aiosqlite:///./data/agentforge.db

# Where ChromaDB keeps its vectors, and where the settings encryption key is
# generated on first run.
CHROMA_PERSIST_DIRECTORY=./data/chroma_data

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Redis for the public-API rate limiter. Without it, counters are per-process,
# so the effective limit is multiplied by the number of uvicorn workers.
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=

# CORS allowlist (comma-separated). Empty accepts any origin, which is what the
# embeddable chat widget needs. Set it if you don't embed the widget elsewhere.
CORS_ORIGINS=

# Encryption key for stored secrets. Generated automatically next to the data
# directory if unset; set it explicitly to manage the key yourself.
#   SECRET_KEY=<urlsafe base64, 32 bytes>
SECRET_KEY=

LOG_LEVEL=INFO
DEBUG=False
